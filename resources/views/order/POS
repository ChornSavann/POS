 @section Scripts {
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script>
        let cart = [];
        let currentTableId = 0;
        const allProducts = @Json.Serialize(Model.Select(p => new {
            id = p.Id,
            name = p.Name,
            barcode = p.barcode,
            price = p.Price,
            discount = p.Discount,
            stock = p.CurrentStock
        }));

        $(document).ready(function() {
            refreshTableUI();

        $('#barcodeScanner').on('input', function() {
             const code = $(this).val().trim();
             if (code !== "") {
                 const product = allProducts.find(p => p.barcode === code);

                 if (product) {
                     addItemToCartLogic(product);
                     const Toast = Swal.mixin({
                         toast: true,
                         position: 'top-end',
                         showConfirmButton: false,
                         timer: 800
                     });
                     Toast.fire({ icon: 'success', title: 'បានថែម: ' + product.name });
                     $(this).val('');
                     $(this).focus();
                 } else {
                     const Toast = Swal.mixin({
                         toast: true,
                         position: 'top-end',
                         showConfirmButton: false,
                         timer: 1500
                     });
                     Toast.fire({
                         icon: 'error',
                         title: 'រកមិនឃើញបាកូដ: ' + code
                     });

                     $(this).val('');
                     $(this).focus();
                 }
             }
         });
        $('#barcodeScanner').on('keypress', function(e) {
            if (e.which == 13) {
                e.preventDefault();
                $(this).trigger('input');
            }
        });

        $('.select-table-btn').click(async function() {
                currentTableId = $(this).data('id');
                const tableName = $(this).data('name');
                const saved = localStorage.getItem('hold_pos_' + currentTableId);
                let customerCountDisplay = "";
                if (saved && JSON.parse(saved).length > 0) {
                    cart = JSON.parse(saved);
                } else {
                    const { value: count } = await Swal.fire({
                        title: 'ចំនួនមនុស្ស',
                        text: `តុ: ${tableName}`,
                        input: 'number',
                        inputValue: 1,
                        showCancelButton: true,
                        confirmButtonText: 'យល់ព្រម',
                        cancelButtonText: 'បោះបង់',
                        inputValidator: (value) => {
                            if (!value || value <= 0) return 'សូមបញ្ចូលចំនួនមនុស្ស!';
                        }
                    });
                    if (!count) return;
                    customerCountDisplay = ` (${count} នាក់)`;
                    cart = [];
                }
                $('#selected-table-id').val(currentTableId);
                $('#selected-table-name').val(`${tableName}${customerCountDisplay}`);
                $('#section-tables').addClass('d-none');
                $('#section-products').removeClass('d-none');
                setTimeout(() => { $('#barcodeScanner').focus(); }, 500);
                updateCart();
            });




       // Declare selectedCat only once globally
        let selectedCat = 'all';

        // Category filter click
        $('#categoryFilter').on('click', 'button', function () {
            selectedCat = $(this).data('category').toString(); // update selected category

            // Update button styles
            $('#categoryFilter button')
                .removeClass('btn-dark active')
                .addClass('btn-outline-dark');

            $(this)
                .removeClass('btn-outline-dark')
                .addClass('btn-dark active');

            filterProducts();
        });


          //Search Product
        $('#productSearch').off('input');

         // ✅ ADD safe search handler only
            $('#productSearch').on('input', function (e) {
                e.stopImmediatePropagation(); // 🚫 stop other handlers
                filterProducts();
            });



        function filterProducts() {
                const searchText = String($('#productSearch').val() || '').toLowerCase();

                $('.product-item').each(function () {

                    const category = String($(this).data('category') || 'all');

                    const name = String(
                        $(this).find('.product-card').data('name') || ''
                    ).toLowerCase();

                    // 🟢 GET STOCK
                    const stock = parseFloat($(this).find('.product-card').data('stock')) || 0;

                    const matchCategory = selectedCat === 'all' || category === selectedCat;
                    const matchSearch   = !searchText || name.includes(searchText);
                    const hasStock      = stock > 0; // ❗ only show stock > 0

                    // show only when have stock
                    $(this).toggleClass('hide', !(matchCategory && matchSearch && hasStock));
                });
            }


          $('#btn-pay-trigger').click(function () {

                if(currentTableId === 0){
                    Swal.fire('សូមជ្រើសតុជាមុន!', '', 'warning');
                    return;
                }

                if (cart.length === 0){
                    Swal.fire('កន្ត្រកទទេ!', '', 'warning');
                    return;
                }

                calculateFinalTotal();
                const modalEl = document.getElementById('checkoutModal');
                const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
          modalInstance.show();
        });

        $('#btn-hold').click(function() {
                if(currentTableId === 0 || cart.length === 0) return;
                localStorage.setItem('hold_pos_' + currentTableId, JSON.stringify(cart));
                $.ajax({
                    url: '/Order/UpdateTableStatus',
                    type: 'POST',
                    data: { tableId: currentTableId, status: 'Busy' },
                    success: function(res) {
                        if(res.success) {
                            Swal.fire({ title: 'រក្សាទុកជោគជ័យ', icon: 'success', timer: 800, showConfirmButton: false });
                            backToTables();
                        }
                    }
                });
            });

            //Clear Card
        $('#clear-cart').click(function() {
                Swal.fire({
                    title: 'តើអ្នកប្រាកដទេ?',
                    text: "រាល់ទិន្នន័យក្នុងកន្ត្រកនឹងត្រូវលុបចោល!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'បាទ/ចាស, លុបវា!',
                    cancelButtonText: 'បោះបង់'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const tableIdToDelete = currentTableId;
                        cart = [];
                        localStorage.removeItem('hold_pos_' + tableIdToDelete);
                        $.ajax({
                            url: '/Order/UpdateTableStatus',
                            type: 'POST',
                            data: { tableId: tableIdToDelete, status: 'Free' },
                            success: function(res) {
                                updateCart();
                                backToTables();
                                Swal.fire('បានលុប!', 'តុត្រូវបានដោះលែងវិញ។', 'success');
                            }
                        });
                    }
                });
            });


         //Input Cash Dallar and Khmer
        $(document).on('input', '#cash-dollar, #cash-riel', () => calculateFinalTotal());
        });

        function addToCartByBarcode(barcode) {
            if (currentTableId === 0) {
                Swal.fire('សូមជ្រើសរើសតុ!', '', 'warning');
                return;
            }
            const product = allProducts.find(p => p.barcode === barcode);
            if (product) {
                addItemToCartLogic(product);
                const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 700 });
                Toast.fire({ icon: 'success', title: product.name });
            } else {
                Swal.fire({ title: 'រកមិនឃើញបាកូដ!', icon: 'error', timer: 1000, showConfirmButton: false });
            }
        }

        //Add to Card
        $('.add-to-cart').click(function() {
            const product = {
                id: $(this).data('id'),
                name: $(this).data('name'),
                price: parseFloat($(this).data('price')) || 0,
                discount: parseFloat($(this).data('discount')) || 0,
                stock: parseInt($(this).data('stock')) || 0
            };

            if (!product.id) return;

            // ហៅ Logic និងឆែកមើលថាជោគជ័យឬអត់
            const isAdded = addItemToCartLogic(product);

            if (isAdded) {
                // បង្ហាញ Toast តែពេលថែមបានជោគជ័យប៉ុណ្ណោះ
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 1500,
                    timerProgressBar: true
                });

                Toast.fire({
                    icon: 'success',
                    title: 'បានថែមក្នុងកន្ត្រក: ' + product.name
                });
            }
        });


        function addItemToCartLogic(d) {
                const existing = cart.find(x => x.id === d.id);
                if (existing) {
                    if (existing.qty < d.stock) {
                        existing.qty++;
                        updateCart();
                        return true; // ថែមបានជោគជ័យ
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'អស់ស្តុក!',
                            text: `ផលិតផលនេះមានត្រឹមតែ ${d.stock} ក្នុងស្តុកប៉ុណ្ណោះ`,
                            confirmButtonColor: '#3085d6'
                        });
                        return false; // បរាជ័យដោយសារអស់ស្តុក
                    }
                } else {
                    if (d.stock > 0) {
                        cart.push({ id: d.id, name: d.name, price: d.price, discount: d.discount, qty: 1 });
                        updateCart();
                        return true; // ថែមថ្មីបានជោគជ័យ
                    } else {
                        Swal.fire('អស់ស្តុក!', 'ផលិតផលនេះមិនមានក្នុងស្តុកទេ', 'error');
                        return false;
                    }
                }
            }

        let currentTaxRate = 0; // តម្លៃ Tax លំនាំដើម %

        function updateCart() {
            const container = $('#cart-items');
            container.empty();

            let subtotalAfterItemDisc = 0;
            let totalOriginalPrice = 0;
            let totalQty = 0;
            let totalItemDiscountDollar = 0;

            cart.forEach((item, index) => {
                const price = parseFloat(item.price) || 0;
                const qty = parseInt(item.qty) || 0;
                const discountAmount = parseFloat(item.discount) || 0;

                const itemOriginalTotal = price * qty;
                const itemAfterDiscTotal = (price - discountAmount) * qty;

                totalOriginalPrice += itemOriginalTotal;
                subtotalAfterItemDisc += itemAfterDiscTotal;
                totalQty += qty;
                totalItemDiscountDollar += (discountAmount * qty);

                container.append(`
                    <div class="border-bottom p-2 small d-flex align-items-center bg-white">
                        <div style="width: 35%" class="khmer fw-bold text-primary text-truncate">${item.name}</div>
                        <div style="width: 15%" class="text-center">$${price.toFixed(2)}</div>
                        <div style="width: 15%" class="text-center px-1">
                            <input type="number" class="form-control form-control-sm text-center shadow-none border-danger text-danger fw-bold"
                                   style="padding: 2px; font-size: 0.8rem;" value="${item.discountRate || 0}"
                                   onfocus="this.select()"
                                   onchange="updateItemDiscount(${index}, this.value)" placeholder="%">
                        </div>
                        <div style="width: 20%" class="text-center d-flex align-items-center justify-content-center">
                            <button class="btn btn-xs btn-outline-secondary p-0 shadow-none" style="width:22px; height:22px;" onclick="changeQty(${index}, -1)">-</button>
                            <span class="mx-2 fw-bold">${qty}</span>
                            <button class="btn btn-xs btn-outline-secondary p-0 shadow-none" style="width:22px; height:22px;" onclick="changeQty(${index}, 1)">+</button>
                        </div>
                        <div style="width: 15%" class="text-end fw-bold text-dark">$${itemAfterDiscTotal.toFixed(2)}</div>
                        <div style="width: 5%" class="text-end">
                            <a href="javascript:void(0)" class="text-danger border-0 bg-transparent" onclick="removeItem(${index})">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>
                        </div>
                    </div>
                `);
            });

            // ១. បង្ហាញ "ទំនិញសរុប"
            $('#item-count-display').text(`${totalQty} ($${totalOriginalPrice.toFixed(2)})`);

            // ២. បញ្ចុះតម្លៃសរុប
            let manualDiscount = parseFloat($('#manual-discount').val()) || 0;
            let grandTotalDiscount = totalItemDiscountDollar + manualDiscount;
            $('#total-discount-display').text(`($${manualDiscount.toFixed(2)}) $${grandTotalDiscount.toFixed(2)}`);

            // ៣. គណនា Tax និង តម្លៃសរុបចុងក្រោយ
            let subtotalFinal = subtotalAfterItemDisc - manualDiscount;
            if (subtotalFinal < 0) subtotalFinal = 0;

            let vatAmount = subtotalFinal * (currentTaxRate / 100);
            let grandTotal = subtotalFinal + vatAmount;

            // បង្ហាញតម្លៃទៅលើ UI Footer
            $('#subtotal').text('$' + subtotalFinal.toFixed(2));
            $('#vat-display').text('$' + vatAmount.toFixed(2));
            $('#grandtotal').text('$' + grandTotal.toFixed(2)); // បង្ហាញតម្លៃបូក Tax រួច ($8.08)

            // ហៅការគណនាសម្រាប់ Modal Checkout
            calculateFinalTotal();

            // បញ្ជាឱ្យ Cursor Focus លើប្រអប់ Scan
            $('#barcodeScanner').focus();
        }

        function openTaxModal() {
                $('#tax-rate-input').val(currentTaxRate);
                $('#taxModal').modal('show');
            }

        function setQuickTax(value) {
            $('#tax-rate-input').val(value);
            // បើចង់ឱ្យចុចហើយ Save យកតែម្តង អាចថែម saveTaxRate() នៅខាងក្រោមនេះ
            // saveTaxRate();
        }

        function saveTaxRate() {
            let inputVal = $('#tax-rate-input').val();
            currentTaxRate = parseFloat(inputVal) || 0;
            $('#taxModal').modal('hide');
            updateCart();
        }

        function backToTables() {
            $('#section-products').addClass('d-none');
                $('#section-tables').removeClass('d-none');
                currentTableId = 0;
                cart = [];
                updateCart();
                refreshTableUI();
                $('#selected-table-name').val('');
        }

        //update discount
        function updateItemDiscount(index, rate) {
                let discountPercent = parseFloat(rate) || 0;

                if (discountPercent < 0) discountPercent = 0;
                if (discountPercent > 100) discountPercent = 100;

                cart[index].discountRate = discountPercent;
                cart[index].discount = (cart[index].price * discountPercent) / 100;

            // ✅ កែពី renderCart() មកជា updateCart() វិញ
            updateCart();
        }


        function refreshTableUI() {
                $('.select-table-btn').each(function() {
                    const id = $(this).data('id');
                    const hasData = localStorage.getItem('hold_pos_' + id);
                    const $badge = $(this).find('.status-badge');
                    if (hasData && JSON.parse(hasData).length > 0) {
                        $(this).addClass('busy');
                        $badge.html('<i class="bi bi-circle-fill me-1 text-danger"></i> មានភ្ញៀវ');
                        $badge.addClass('text-danger border-danger');
                    } else {
                        $(this).removeClass('busy');
                        $badge.html('<i class="bi bi-circle-fill me-1 text-success"></i> ទំនេរ');
                        $badge.removeClass('text-danger border-danger');
                    }
                });
            }
        function addCash(val) {
                let cur = parseFloat($('#cash-dollar').val()) || 0;
                $('#cash-dollar').val(cur + val);
                calculateFinalTotal();
            }
        function clearCash() {

                 // Clear cash inputs
                $('#cash-dollar, #cash-riel').val('0');

                // Reset manual discount
                $('#manual-discount').val('0');

                // Reset discount section
                $('#discountRate, #discountAmount').val('0');

                // Reset payment method select to default placeholder
                $('#paymentMethod').prop('selectedIndex', 0);

                // Recalculate totals
                calculateFinalTotal();
            }

           //Update Qty
        function changeQty(i, v) {
                const item = cart[i];
                const product = allProducts.find(p => p.id === item.id);

                // បើកើនចំនួន ត្រូវឆែកស្តុកសិន
                if (v > 0) {
                    if (product && item.qty >= product.stock) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'អស់ស្តុក!',
                            text: `ផលិតផលនេះមានត្រឹមតែ ${product.stock} ក្នុងស្តុកប៉ុណ្ណោះ`,
                            timer: 2000,
                            showConfirmButton: false
                        });
                        return; // បញ្ឈប់ មិនឱ្យកើនលើសស្តុក
                    }
                }

                // ធ្វើការបូក/ដកចំនួន
                item.qty += v;
                if (item.qty <= 0) {
                    cart.splice(i, 1);
                    toastr.info("បានលុបទំនិញចេញពីកន្ត្រក");
                }

                updateCart();
            }

        function removeItem(index) {
            cart.splice(index, 1);
            updateCart();
        }

        // ================= CONFIG & CONSTANTS =================
        const EXCHANGE_RATE = 4100;


        function getSubtotal() {
            // ទាញតម្លៃពី Table Cart (ដកសញ្ញា $ ចេញ)
            return parseFloat($('#subtotal').text().replace(/[^0-9.-]+/g, '')) || 0;
        }


        function calculateFinalTotal() {
            // ១. ទាញតម្លៃ Grand Total ដែលបានគណនារួចស្រេចពី Footer (រួមទាំង Tax និង Item Discount)
            let grandText = $('#grandtotal').text().replace('$', '').trim();
            let grand = parseFloat(grandText) || 0;

            // ២. ទាញយកការបញ្ចុះតម្លៃបន្ថែមក្នុង Modal (ឧទាហរណ៍៖ ចុះ % ពីធនាគារ)
            const bankDiscRate = parseFloat($('#discountRate').val()) || 0;
            const bankDiscAmount = (grand * bankDiscRate) / 100;

            // តម្លៃចុងក្រោយដែលភ្ញៀវត្រូវបង់ពិតប្រាកដ
            const finalGrandTotal = Math.max(0, grand - bankDiscAmount);

            // ៣. បង្ហាញលទ្ធផលទៅកាន់ Modal UI
            $('#discountAmount').val(bankDiscAmount.toFixed(2)); // បង្ហាញចំនួនលុយដែលចុះបន្ថែម
            $('#modal-subtotal').text('$' + finalGrandTotal.toFixed(2));
            $('#total-riel').text((finalGrandTotal * EXCHANGE_RATE).toLocaleString() + ' ៛');

            // ៤. គណនាការបង់ប្រាក់ និងលុយអាប់
            let paidD = parseFloat($('#cash-dollar').val()) || 0;
            let paidR = parseFloat($('#cash-riel').val()) || 0;
            let totalPaid = paidD + (paidR / EXCHANGE_RATE);

            let balance = totalPaid - finalGrandTotal;
            let debt = Math.max(0, finalGrandTotal - totalPaid);

            // ៥. បង្ហាញលុយអាប់ ឬ លុយជំពាក់
            $('#balance-dollar').text(balance > 0 ? '$' + balance.toFixed(2) : '$0.00');
            $('#balance-riel').text(balance > 0 ? (Math.round(balance * EXCHANGE_RATE)).toLocaleString() + ' ៛' : '0 ៛');
            $('#debt-amount').text('$' + debt.toFixed(2));

            // ៦. Update Status (បង់គ្រប់, ជំពាក់, ឬ បង់ខ្លះ)
            updatePaymentStatusUI(finalGrandTotal, totalPaid);
        }

        function updatePaymentStatusUI(grandTotal, totalPaid) {
                const $status = $('#payment-status');

                // សម្អាត Class ចាស់ៗចេញ (ទាំងអក្សរ និង Badge)
                $status.removeClass('text-danger text-warning text-success badge bg-danger bg-warning bg-success text-dark');

                if (totalPaid <= 0) {
                    $status.text('ជំពាក់ (Credit)')
                           .addClass('badge bg-danger px-3 py-2 shadow-sm');
                } else if (totalPaid < (grandTotal - 0.01)) {
                    $status.text('បង់ខ្លះ (Partial)')
                           .addClass('badge bg-warning text-dark px-3 py-2 shadow-sm');
                } else {
                    $status.text('បង់គ្រប់ (Paid)')
                           .addClass('badge bg-success px-3 py-2 shadow-sm');
                }
        }


        function handleConfirmPayment() {
             const currentTableId = parseInt($('#selected-table-id').val()) || 0;
             const customerId = parseInt($('#CustomersId').val()) || 0;
             const EXCHANGE_RATE = 4100;

             // ១. ប្រមូលទិន្នន័យតម្លៃ
             const subtotal = getSubtotal();
             const discountRate = parseFloat($('#discountRate').val()) || 0;
             const manualDiscount = parseFloat($('#manual-discount').val()) || 0;

             // ២. គណនា Discount (ដូចកូដដើមរបស់បង)
             let totalItemDiscount = 0;
             const itemsData = cart.map(item => {
                 const directItemDiscount = parseFloat(item.discount) || 0;
                 const bankDiscountPerItem = ((item.price - directItemDiscount) * discountRate / 100);
                 const totalDiscountPerUnit = directItemDiscount + bankDiscountPerItem;
                 totalItemDiscount += (totalDiscountPerUnit * item.qty);

                 return {
                     Id: item.id,
                     Qty: item.qty,
                     Price: item.price,
                     Discount: totalDiscountPerUnit
                 };
             });

             // --- ចំណុចបន្ថែមថ្មី៖ គណនា Tax និង GrandTotal ---
             const totalAfterDiscount = subtotal - (totalItemDiscount + manualDiscount);

             // ទាញយក currentTaxRate ដែលយើងបង្កើតក្នុង updateCart
             const taxAmount = totalAfterDiscount * (currentTaxRate / 100);
             const grandTotal = totalAfterDiscount + taxAmount;
             // ------------------------------------------

             const paidDollar = parseFloat($('#cash-dollar').val()) || 0;
             const paidRiel = parseFloat($('#cash-riel').val()) || 0;
             const totalPaid = paidDollar + (paidRiel / EXCHANGE_RATE);

             // ៤. លក្ខខណ្ឌការពារ
             if (currentTableId === 0) {
                 Swal.fire('បញ្ជាក់', 'សូមជ្រើសរើសតុមុនពេលទូទាត់!', 'warning');
                 return;
             }

             if (totalPaid < (grandTotal - 0.01) && !$('#allowCredit').is(':checked')) {
                 Swal.fire('លុយមិនគ្រប់', `ទឹកប្រាក់ត្រូវបង់គឺ $${grandTotal.toFixed(2)}`, 'warning');
                 return;
             }

             // ៥. រៀបចំទិន្នន័យផ្ញើទៅ Server
             const selectedOption = $('#paymentMethod').find('option:selected');
             const bName = selectedOption.data('bankname') || 'CASH';
             const loggedInSellerId = parseInt($('#currentSellerId').val()) || 1;

             const orderData = {
                 TableId: currentTableId,
                 CustomerId: customerId,
                 Discount: totalItemDiscount + manualDiscount,
                 Tax: taxAmount,         // បញ្ជូនតម្លៃអាករទៅ Server
                 TaxRate: currentTaxRate, // បញ្ជូន % អាករទៅ Server
                 BankDiscount: discountRate,
                 BankDiscountName: bName,
                 PaymentMethod: bName,
                 PaidDollar: paidDollar,
                 PaidRiel: paidRiel,
                 Note: $('#order-note').val(),
                 SalerId: loggedInSellerId,
                 StoreId: parseInt($('#currentStoreId').val()) || 1,
                 Items: itemsData
             };

             // ៦. បាញ់ទៅ Server
                $.ajax({
                    url: '/Order/Checkout',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(orderData),
                    beforeSend: function() {
                        Swal.showLoading();
                        $('#confirm-payment').prop('disabled', true);
                    },
                    success: function(res) {
                        if (res.success) {
                            localStorage.removeItem('hold_pos_' + currentTableId);
                            window.location.href = '/Order/Invoicepos/' + res.orderId;
                        } else {
                            Swal.fire('បរាជ័យ', res.message, 'error');
                            $('#confirm-payment').prop('disabled', false);
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'ការតភ្ជាប់មានបញ្ហា!', 'error');
                        $('#confirm-payment').prop('disabled', false);
                    }
                });
         }


        $(document).ready(function() {
            // រាល់ពេលប្តូរវិធីបង់ប្រាក់ (ABA, ACLEDA...)
            $('#paymentMethod').on('change', function() {
                const rate = $(this).find(':selected').data('discount') || 0;
                $('#discountRate').val(rate);
                calculateFinalTotal();
            });

            // រាល់ពេលវាយលេខលុយ
            $(document).on('input', '#cash-dollar, #cash-riel, #manual-discount', calculateFinalTotal);

            // ចុចប៊ូតុងបង់ប្រាក់
            $('#confirm-payment').on('click', handleConfirmPayment);
        });


 $('#btn-print').click(function() {
    if (currentTableId === 0) {
        Swal.fire('បញ្ជាក់', 'សូមជ្រើសរើសតុជាមុន!', 'warning');
        return;
    }

    // ទាញឈ្មោះតុពី UI
    const tableName = $('#selected-table-name').text().trim() || "តុលេខ " + currentTableId;
    const tableData = localStorage.getItem('hold_pos_' + currentTableId);

    let form = document.createElement("form");
    // កុំដាក់ form.target = "_blank" ដើម្បីកុំឱ្យវាលោត Page ថ្មី
    form.method = "POST";
    form.action = "/Order/PrintPreview";

    form.appendChild(createHiddenInput("tableId", currentTableId));
    form.appendChild(createHiddenInput("tableName", tableName));
    if (tableData) {
        form.appendChild(createHiddenInput("jsonData", tableData));
    }

    document.body.appendChild(form);
    form.submit();
    document.body.removeChild(form);
});

function createHiddenInput(name, value) {
    let input = document.createElement("input");
    input.type = "hidden";
    input.name = name;
    input.value = value;
    return input;
}
    </script>

    <script>
    // ១. ប្រកាស Function ជាលក្ខណៈ Global (ដាក់នៅខាងលើគេបង្អស់ ដើម្បីឱ្យគ្រប់កន្លែងស្គាល់វា)
    function showToast(icon, title) {
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        Toast.fire({
            icon: icon,
            title: title
        });
    }

    $(document).ready(function() {
        // ២. មុខងារសម្រាប់ប៊ូតុង "កម្ម៉ង់"
        $('#btn-order').click(function() {
            // ឆែកមើលទិន្នន័យក្នុងកន្ត្រក
            if (cart.length === 0) {
                Swal.fire('បញ្ជាក់', 'សូមជ្រើសរើសមុខម្ហូបជាមុន!', 'warning');
                return;
            }

            // ឆែកមើលលេខតុ
            if (currentTableId === 0) {
                Swal.fire('បញ្ជាក់', 'សូមជ្រើសរើសតុជាមុន!', 'warning');
                return;
            }

            // រៀបចំទិន្នន័យឱ្យត្រូវតាម Class OrderItem ក្នុង C#
            const formattedItems = cart.map(item => ({
                ProductId: item.id,
                Qty: item.qty,
                Price: item.price,
                Discount: item.discount
            }));

            // បង្ហាញ Loading
            Swal.showLoading();

            $.ajax({
                url: '/Order/SendToKitchen',
                type: 'POST',
                data: {
                    tableId: currentTableId,
                    items: JSON.stringify(formattedItems)
                },
                success: function(res) {
                    Swal.close(); // បិទ Loading

                    if(res.success) {
                        // ហៅប្រើ showToast ដែលយើងបានប្រកាសខាងលើ
                        showToast('success', 'បានរក្សាទុក និងផ្ញើទៅផ្ទះបាយ!');

                        // រក្សាទុកក្នុង LocalStorage ដើម្បីចំណាំតុរវល់ (Busy Table)
                        localStorage.setItem('hold_pos_' + currentTableId, JSON.stringify(cart));

                        // ធ្វើបច្ចុប្បន្នភាព UI តុ (ប្តូរពណ៌តុ)
                        if (typeof refreshTableUI === "function") {
                            refreshTableUI();
                        }

                        // ប្រសិនបើបងចង់ឱ្យសម្អាត Cart ក្រោយកម្ម៉ង់រួច បើក Comment ខាងក្រោម
                        // cart = [];
                        // updateCartUI();

                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function(xhr, status, error) {
                    Swal.close();
                    console.error("AJAX Error: ", error);
                    Swal.fire('Error', 'បណ្ដាញមានបញ្ហា ឬ Server មាន Error!', 'error');
                }
            });
        });
    });
</script>

