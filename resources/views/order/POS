<style>
    /* Section Header */
    .khmer { font-family: 'Kantumruy Pro', sans-serif; }

    /* Table Card Base */
    .table-card {
        background: #ffffff;
        border: 2px solid #e9ecef;
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    /* Icon Styling */
    .img-wrapper img {
        width: 60px;
        height: auto;
        filter: grayscale(100%);
        opacity: 0.6;
        transition: all 0.3s ease;
    }

    /* Status: Available */
    .table-card:hover:not(.busy) {
        border-color: #0d6efd;
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.15);
    }

    .table-card:hover:not(.busy) .img-wrapper img {
        filter: grayscale(0%);
        opacity: 1;
        transform: scale(1.1);
    }

    /* Status: Busy */
    .table-card.busy {
        background-color: #fff5f5;
        border-color: #feb2b2;
        cursor: not-allowed;
    }

    .table-card.busy .img-wrapper img {
        filter: sepia(1) saturate(5) hue-rotate(-50deg); /* Makes icon reddish */
        opacity: 0.9;
    }

    .table-card.busy .table-name { color: #c53030; }

    /* Custom Badges */
    .status-badge {
        font-size: 0.75rem;
        padding: 4px 12px;
        border-radius: 50px;
        border: 1px solid;
        display: inline-flex;
        align-items: center;
        font-weight: 600;
    }

    /* Table Name */
    .table-name {
        font-size: 1.1rem;
        color: #2d3748;
        margin-top: 10px;
    }

    /* Selected State (When clicked) */
    .table-card.selected {
        border-color: #0d6efd;
        background-color: #e0e7ff;
        ring: 3px solid #3b82f6;
    }
</style>

<div class="container-fluid pos-layout py-2">

    <div class="row g-2 h-100">
        <div class="col-md-4 h-100">
            <div class="cart-container shadow-sm rounded bg-white border">
            <!-- Top Inputs -->
            <div class="p-2 border-bottom">
                <div class="row g-1">
                    <!-- Table Selection -->
                    <div class="col-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-table"></i>
                            </span>
                            <input type="text" id="selected-table-name"
                                   class="form-control fw-bold text-primary"
                                   readonly placeholder="សូមជ្រើសរើសតុ">
                        </div>
                        <input type="hidden" id="selected-table-id" value="0">
                    </div>
                    <!-- Customer Selection -->
                    <div class="col-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person"></i>
                            </span>
                            <select id="CustomersId" name="CustomerId" class="form-select">
                                <option value="0">Walk-In Customer</option>
                                @foreach (var c in ViewBag.Customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <!-- Barcode Scanner -->
                    <div class="col-12">
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text bg-primary text-white">
                                <i class="bi bi-upc-scan"></i>
                            </span>
                            <input type="text" id="barcodeScanner" class="form-control form-control-sm"
                                   placeholder="បាញ់បាកូដនៅទីនេះ (Auto-add)..." autofocus autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cart Header -->
           <div class="bg-dark text-white p-2 khmer d-flex align-items-center small">
                <span style="width:35%"><i class="bi bi-box-seam me-1"></i>ឈ្មោះទំនិញ</span>
                <span style="width:15%" class="text-center"><i class="bi bi-tag me-1"></i>តម្លៃ</span>
                <span style="width:15%" class="text-center"><i class="bi bi-percent me-1"></i>បញ្ចុះតម្លៃ</span>
                <span style="width:20%" class="text-center"><i class="bi bi-plus-slash-minus me-1"></i>ចំនួន</span>
                <span style="width:15%" class="text-end"><i class="bi bi-cash-stack me-1"></i>សរុប</span>
            </div>

            <!-- Cart Items -->
            <div id="cart-items" class="cart-body p-2">
                <div class="text-center text-muted mt-5">សូមជ្រើសរើសតុដើម្បីចាប់ផ្តើម</div>
            </div>

            <!-- Footer -->
            <div class="cart-footer p-0 border-top bg-white">
                <div class="summary-area p-2" style="background-color: #e3f2fd; font-size: 0.85rem;">
                    <div class="row g-0">
                        <div class="col-6">
                            <div class="d-flex justify-content-between pe-2 border-end border-white">
                                <span class="khmer">ទំនិញសរុប</span>
                                <span id="item-count-display" class="fw-bold">0 ($0.00)</span>
                            </div>
                            <div class="d-flex justify-content-between pe-2 border-end border-white mt-1">
                                <span class="khmer">បញ្ចុះតម្លៃ</span>
                                <span id="total-discount-display" class="text-primary">($0.00) $0.00</span>
                            </div>
                        </div>
                        <div class="col-6 ps-2">
                            <div class="d-flex justify-content-between">
                                <span class="khmer">សរុប</span>
                                <span id="subtotal" class="fw-bold">$0.00</span>
                            </div>
                           <div class="d-flex justify-content-between mt-1">
                            <span class="khmer">
                                អាករលើតម្លៃបន្ថែម
                                <a href="javascript:void(0)" onclick="openTaxModal()" class="text-primary ms-1"><i class="bi bi-pencil-square"></i></a>
                            </span>
                            <span id="vat-display" class="fw-bold">$0.00</span>
                        </div>
                        </div>
                    </div>
                </div>

                <div class="grand-total-area px-3 py-2 d-flex justify-content-between align-items-center" style="background-color: #dcedc8;">
                    <span class="khmer fw-bold fs-6">ប្រាក់ត្រូវបង់ <i class="bi bi-chat-dots-fill small"></i></span>
                    <h3 id="grandtotal" class="mb-0 fw-bold">$0.00</h3>
                </div>

               <div class="d-flex" style="height: 80px;">
                    <div class="d-flex flex-column" style="width: 30%;">
                        <button class="btn btn-warning rounded-0 border-white text-white flex-fill khmer py-1" id="btn-hold" style="background-color: #ff9800;">
                            <i class="fa-solid fa-hand-pause me-1"></i> ពន្យារ
                        </button>
                        <button class="btn btn-danger rounded-0 border-white text-white flex-fill khmer py-1" id="clear-cart">
                            <i class="fa-solid fa-trash-can me-1"></i> ទេ
                        </button>
                    </div>

                    <div class="d-flex flex-column" style="width: 30%;">
                        <button class="btn rounded-0 border-white text-white flex-fill khmer py-1" id="btn-order" style="background-color: #7e57c2;">
                            <i class="fa-solid fa-utensils me-1"></i> កម្ម៉ង់
                        </button>
                        <button class="btn rounded-0 border-white text-white flex-fill khmer py-1" id="btn-print" style="background-color: #1a237e;">
                            <i class="fa-solid fa-print me-1"></i> ចេញបុង
                        </button>
                    </div>

                    <div class="flex-grow-1">
                        <button class="btn btn-success rounded-0 h-100 w-100 khmer fs-5 fw-bold" id="btn-pay-trigger" style="background-color: #2e7d32;">
                            <i class="fa-solid fa-money-bill-wave me-2"></i> បង់ប្រាក់
                        </button>
                    </div>
               </div>
            </div>
        </div>
        </div>
        <div class="col-md-8 h-100">
           <div id="section-tables" class="mt-2">
                <div class="bg-white p-2 mb-3 shadow-sm rounded-3 d-flex justify-content-between align-items-center border-start border-primary border-4">
                    <h6 class="khmer mb-0 fw-bold">
                        <i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>ជ្រើសរើសតុ
                    </h6>
                    <span class="badge bg-dark rounded-pill" style="font-size: 10px;">តុសរុប: @ViewBag.Tables.Count</span>
                </div>

                <div class="row g-2">
                    @foreach (var table in ViewBag.Tables)
                    {
                        <div class="col-xl-2 col-lg-2 col-md-3 col-4"> <div class="table-card text-center p-2 select-table-btn @(table.Status == "Busy" ? "busy" : "")"
                                 data-id="@table.Id"
                                 data-name="@table.Name">

                                <div class="img-wrapper mb-1">
                                    <img src="~/Image/Logo/logo_table-removebg-preview-removebg-preview.png" alt="Table Icon" style="width: 40px;" />
                                </div>

                                <div class="fw-bold khmer table-name" style="font-size: 0.85rem;">@table.Name</div>

                                <div class="mt-1">
                                    <span class="status-badge khmer @(table.Status == "Busy" ? "text-danger border-danger" : "text-success border-success")" style="font-size: 9px; padding: 2px 6px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 5px;"></i>
                                        @(table.Status == "Busy" ? "មានភ្ញៀវ" : "ទំនេរ")
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

           <div id="section-products" class="d-none">
               <div class="d-flex flex-wrap align-items-center gap-2">

                    <button class="btn btn-danger btn-sm khmer px-3 shadow-sm" onclick="backToTables()">
                        <i class="bi bi-arrow-left-circle me-1"></i> ត្រឡប់មកវិញ
                    </button>

                    <div class="d-flex gap-2 flex-wrap flex-grow-1" id="categoryFilter">
                        <button class="btn btn-sm btn-dark active rounded-pill px-3" data-category="all">
                            ទាំងអស់
                        </button>

                        @{
                            var categories = ViewBag.Categories as List<ItemType>;
                        }

                        @if (categories != null && categories.Any())
                        {
                            foreach (var c in categories)
                            {
                                var hasStock = c.Products != null && c.Products.Any(p => p.CurrentStock > 0);
                                if (hasStock)
                                {
                                    <button class="btn btn-sm btn-outline-dark rounded-pill px-3" data-category="@c.Id">
                                        @c.ItemtypeName
                                    </button>
                                }
                            }
                        }
                    </div>

                    <div class="input-group shadow-sm" style="width: 250px;">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="productSearch" class="form-control form-control-sm border-start-0 khmer" placeholder="ស្វែងរកទំនិញ...">
                    </div>
               </div>
               <div class="row g-3 overflow-auto p-1" style="height: 80vh;">
                        @foreach (var p in Model)
                            {
                                <div class="col-xl-2 col-lg-3 col-md-4 col-4 product-item" data-category="@p.ItemTypeId">

                                    <div class="card product-card add-to-cart" data-id="@p.Id" data-name="@p.Name" data-price="@p.Price" data-discount="@p.Discount" data-stock="@p.CurrentStock">
                                        <img src="@p.ImagePath" onerror="this.src='/images/no-image.png'">
                                        <div class="card-body p-2 text-center border-top">
                                            <p class="khmer small mb-1 text-truncate fw-bold">@p.Name</p>
                                            <span class="text-primary fw-bold">$@p.Price</span>
                                        </div>
                                    </div>
                                </div>
                            }
                    </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">

            <!-- Header -->
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-credit-card me-2"></i> ការទូទាត់ប្រាក់
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body bg-light p-4">
                <div class="row g-4">

                    <!-- LEFT -->
                    <div class="col-md-7">

                        <!-- Total Summary -->
                        <div class="card border-0 shadow-sm mb-3 rounded-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold text-muted">សរុប ($)</span>
                                    <h3 id="modal-subtotal" class="text-primary fw-bold mb-0">$0.00</h3>
                                </div>
                                <div class="d-flex justify-content-between mt-2">
                                    <span class="fw-semibold text-muted">សរុប (៛)</span>
                                    <h4 id="total-riel" class="text-success fw-bold mb-0">0 ៛</h4>
                                </div>
                            </div>
                        </div>

                        <!-- Cash Dollar -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">ទទួលលុយដុល្លារ</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>
                                <input type="number" id="cash-dollar" class="form-control text-end" value="0">
                            </div>
                        </div>

                      <!-- Payment Method -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">វិធីបង់ប្រាក់</label>
                            <input type="hidden" id="bankAccountName" value="">

                           <select id="paymentMethod" class="form-select form-select-lg">
                                <option value="" data-bankname="CASH">💵 សាច់ប្រាក់សុទ្ធ (Cash)</option>
                                @foreach (var c in ViewBag.Banks)
                                {
                                    <option value="@c.Id" data-discount="@c.DiscountRate" data-bankname="@c.BankName">
                                        🏦 @c.BankName
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Discount -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">បញ្ចុះ (%)</label>
                                <input type="number" id="discountRate"
                                       class="form-control form-control-lg text-end"
                                       readonly>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold text-danger">បញ្ចុះ ($)</label>
                                <input type="text" id="discountAmount"
                                       class="form-control form-control-lg text-end text-danger"
                                       readonly>
                            </div>
                        </div>

                        <!-- Cash Riel -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">ទទួលលុយរៀល</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">៛</span>
                                <input type="number" id="cash-riel" class="form-control text-end" value="0">
                            </div>
                        </div>

                        <hr>

                        <!-- Balance -->
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-danger">លុយអាប់</span>
                            <h4 id="balance-dollar" class="text-danger fw-bold mb-0">$0.00</h4>
                        </div>

                        <!-- Credit -->
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="allowCredit">
                            <label class="form-check-label fw-bold text-warning">
                                អនុញ្ញាតឲ្យជំពាក់
                            </label>
                        </div>

                        <div class="d-flex justify-content-between mt-2">
                            <span class="fw-bold text-warning">ប្រាក់ជំពាក់</span>
                            <h5 id="debt-amount" class="fw-bold text-warning mb-0">$0.00</h5>
                        </div>

                        <div class="mt-2">
                            <span class="fw-bold">ស្ថានភាព:</span>
                            <span id="payment-status" class="badge bg-secondary ms-2">—</span>
                        </div>
                    </div>

                    <!-- RIGHT -->
                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body">
                                <div class="row g-2">
                                    @foreach (var val in new[] { 1, 5, 10, 20, 50, 100 })
                                    {
                                        <div class="col-6">
                                            <button class="btn btn-outline-primary w-100 py-3 fw-bold"
                                                    onclick="addCash(@val)">
                                                $@val
                                            </button>
                                        </div>
                                    }
                                    <div class="col-12 mt-2">
                                        <button class="btn btn-outline-danger w-100"
                                                onclick="clearCash()">
                                            <i class="bi bi-x-circle me-1"></i> សម្អាតលុយ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0">
                <button type="button"
                        class="btn btn-success w-100 py-3 fw-bold fs-5 rounded-4"
                        id="confirm-payment">
